    517          /*********************************************************************
    518           * @fn      GenericApp_MessageMSGCB
    519           *
    520           * @brief   Data message processor callback.  This function processes
    521           *          any incoming data - probably from other devices.  So, based
    522           *          on cluster ID, perform the intended action.
    523           *
    524           * @param   none
    525           *
    526           * @return  none
    527           */
    528          static void GenericApp_MessageMSGCB( afIncomingMSGPacket_t *pkt )
    529          {
    530            switch ( pkt->clusterId )
    531            {
    532              case GENERICAPP_CLUSTERID:
    533                // "the" message
    534          #if defined( LCD_SUPPORTED )
    535                HalLcdWriteScreen( (char*)pkt->cmd.Data, "rcvd" );
    536          #elif defined( WIN32 )
    537                WPRINTSTR( pkt->cmd.Data );
    538          #endif
    539                break;
    540            }
    541          }
    542          
    543          /*********************************************************************
    544           * @fn      GenericApp_SendTheMessage
    545           *
    546           * @brief   Send "the" message.
    547           *
    548           * @param   none
    549           *
    550           * @return  none
    551           */
    552          static void GenericApp_SendTheMessage( void )
    553          {
    554            char theMessageData[] = "Hello World";
    555          
    556            if ( AF_DataRequest( &GenericApp_DstAddr, &GenericApp_epDesc,
    557                                 GENERICAPP_CLUSTERID,
    558                                 (byte)osal_strlen( theMessageData ) + 1,
    559                                 (byte *)&theMessageData,
    560                                 &GenericApp_TransID,
    561                                 AF_DISCV_ROUTE, AF_DEFAULT_RADIUS ) == afStatus_SUCCESS )
    562            {
    563              // Successfully requested to be sent.
    564            }
    565            else
    566            {
    567              // Error occurred in request to send.
    568            }
    569          }
    570          
    571          #if defined( IAR_ARMCM3_LM )
    572          /*********************************************************************
    573           * @fn      GenericApp_ProcessRtosMessage
    574           *
    575           * @brief   Receive message from RTOS queue, send response back.
    576           *
    577           * @param   none
    578           *
    579           * @return  none
    580           */
    581          static void GenericApp_ProcessRtosMessage( void )
    582          {
    583            osalQueue_t inMsg;
    584          
    585            if ( osal_queue_receive( OsalQueue, &inMsg, 0 ) == pdPASS )
    586            {
    587              uint8 cmndId = inMsg.cmnd;
    588              uint32 counter = osal_build_uint32( inMsg.cbuf, 4 );
    589          
    590              switch ( cmndId )
    591              {
    592                case CMD_INCR:
    593                  counter += 1;  /* Increment the incoming counter */
    594                                 /* Intentionally fall through next case */
    595          
    596                case CMD_ECHO:
    597                {
    598                  userQueue_t outMsg;
    599          
    600                  outMsg.resp = RSP_CODE | cmndId;  /* Response ID */
    601                  osal_buffer_uint32( outMsg.rbuf, counter );    /* Increment counter */
    602                  osal_queue_send( UserQueue1, &outMsg, 0 );  /* Send back to UserTask */
    603                  break;
    604                }
    605                
    606                default:
    607                  break;  /* Ignore unknown command */    
    608              }
    609            }
    610          }
    611          #endif
