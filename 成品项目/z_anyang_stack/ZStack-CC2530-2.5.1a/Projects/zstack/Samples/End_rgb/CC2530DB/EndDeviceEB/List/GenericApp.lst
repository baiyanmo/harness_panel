    509          /*********************************************************************
    510           * @fn      GenericApp_ProcessZDOMsgs()
    511           *
    512           * @brief   处理ZDO响应消息
    513           *
    514           * @param   无
    515           *
    516           * @return  无
    517           */
    518          static void GenericApp_ProcessZDOMsgs( zdoIncomingMsg_t *inMsg )
    519          {
    520            switch ( inMsg->clusterID )
    521            {
    522              case End_Device_Bind_rsp:
    523                if ( ZDO_ParseBindRsp( inMsg ) == ZSuccess )
    524                {
    525                  // 绑定成功，点亮LED
    526                  HalLedSet( HAL_LED_4, HAL_LED_MODE_ON );
    527                }
    528          #if defined( BLINK_LEDS )
    529                else
    530                {
    531                  // 绑定失败，闪烁LED提示
    532                  HalLedSet ( HAL_LED_4, HAL_LED_MODE_FLASH );
    533                }
    534          #endif
    535                break;
    536          
    537              case Match_Desc_rsp:
    538                {
    539                  ZDO_ActiveEndpointRsp_t *pRsp = ZDO_ParseEPListRsp( inMsg );
    540                  if ( pRsp )
    541                  {
    542                    if ( pRsp->status == ZSuccess && pRsp->cnt )
    543                    {
    544                      GenericApp_DstAddr.addrMode = (afAddrMode_t)Addr16Bit;
    545                      GenericApp_DstAddr.addr.shortAddr = pRsp->nwkAddr;
    546                      // 取第一个端点，也可以遍历所有端点进行搜索
    547                      GenericApp_DstAddr.endPoint = pRsp->epList[0];
    548          
    549                      // 匹配成功，点亮LED
    550                      HalLedSet( HAL_LED_4, HAL_LED_MODE_ON );
    551                    }
    552                    osal_mem_free( pRsp );
    553                  }
    554                }
    555                break;
    556            }
    557          }
    558          
    559          /*********************************************************************
    560           * @fn      GenericApp_HandleKeys
    561           *
    562           * @brief   处理本设备的所有按键事件
    563           *
    564           * @param   shift - 是否按下Shift/Alt键（双功能键）。
    565           * @param   keys  - 按键事件位域。有效值：
    566           *                  HAL_KEY_SW_4
    567           *                  HAL_KEY_SW_3
    568           *                  HAL_KEY_SW_2
    569           *                  HAL_KEY_SW_1
    570           *
    571           * @return  无
    572           */
    573          static void GenericApp_HandleKeys( uint8 shift, uint8 keys )
    574          {
    575            zAddrType_t dstAddr;
    576          
    577            // Shift用于实现每个按键的双功能
    578            if ( shift )
    579            {
    580              if ( keys & HAL_KEY_SW_1 )
    581              {
    582              }
    583              if ( keys & HAL_KEY_SW_2 )
    584              {
    585              }
    586              if ( keys & HAL_KEY_SW_3 )
    587              {
    588              }
    589              if ( keys & HAL_KEY_SW_4 )
    590              {
    591              }
    592            }
    593            else
    594            {
    595              if ( keys & HAL_KEY_SW_1 )
    596              {
    597                // SW1在本应用中未用于其他功能
    598          #if defined( SWITCH1_BIND )
    599                // 可以用SW1模拟SW2的功能（用于只有一个按键的设备）
    600                keys |= HAL_KEY_SW_2;
    601          #elif defined( SWITCH1_MATCH )
    602                // 或者用SW1模拟SW4的功能（用于只有一个按键的设备）
    603                keys |= HAL_KEY_SW_4;
    604          #endif
    605              }
    606          
    607              if ( keys & HAL_KEY_SW_2 )
    608              {
    609                HalLedSet ( HAL_LED_4, HAL_LED_MODE_OFF );
    610          
    611                // 向协调器发起终端设备绑定请求
    612                dstAddr.addrMode = Addr16Bit;
    613                dstAddr.addr.shortAddr = 0x0000; // 协调器地址
    614                ZDP_EndDeviceBindReq( &dstAddr, NLME_GetShortAddr(),
    615                                      GenericApp_epDesc.endPoint,
    616                                      GENERICAPP_PROFID,
    617                                      GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    618                                      GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    619                                      FALSE );
    620              }
    621          
    622              if ( keys & HAL_KEY_SW_3 )
    623              {
    624              }
    625          
    626              if ( keys & HAL_KEY_SW_4 )
    627              {
    628                HalLedSet ( HAL_LED_4, HAL_LED_MODE_OFF );
    629                // 发起匹配描述符请求（服务发现）
    630                dstAddr.addrMode = AddrBroadcast;
    631                dstAddr.addr.shortAddr = NWK_BROADCAST_SHORTADDR;
    632                ZDP_MatchDescReq( &dstAddr, NWK_BROADCAST_SHORTADDR,
    633                                  GENERICAPP_PROFID,
    634                                  GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    635                                  GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    636                                  FALSE );
    637              }
    638            }
    639          }
