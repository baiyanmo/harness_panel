    744          /*********************************************************************
    745           * @fn      GenericApp_SendTheMessage
    746           *
    747           * @brief   发送消息
    748           *
    749           * @param   无
    750           *
    751           * @return  无
    752           */
    753          static void GenericApp_SendTheMessage( void )
    754          {
    755            //char theMessageData[] = "Hello World";
    756          
    757            if ( AF_DataRequest( &GenericApp_DstAddr, &GenericApp_epDesc,
    758                                 GENERICAPP_CLUSTERID,
    759                                 (byte)sizeof(node1) + 1,
    760                                 (byte *)&node1,
    761                                 &GenericApp_TransID,
    762                                 AF_DISCV_ROUTE, AF_DEFAULT_RADIUS ) == afStatus_SUCCESS )
    763            {
    764              // 数据请求发送成功
    765               HalLcdWriteString( "Send Sucess",HAL_LCD_LINE_7);
    766            }
    767            else
    768            {
    769              // 数据请求发送失败
    770              HalLcdWriteString( "Send Failed",HAL_LCD_LINE_7);
    771            }
    772          }
    773          
    774          #if defined( IAR_ARMCM3_LM )
    775          /*********************************************************************
    776           * @fn      GenericApp_ProcessRtosMessage
    777           *
    778           * @brief   从RTOS队列接收消息并发送响应
    779           *
    780           * @param   无
    781           *
    782           * @return  无
    783           */
    784          static void GenericApp_ProcessRtosMessage( void )
    785          {
    786            osalQueue_t inMsg;
    787          
    788            if ( osal_queue_receive( OsalQueue, &inMsg, 0 ) == pdPASS )
    789            {
    790              uint8 cmndId = inMsg.cmnd;
    791              uint32 counter = osal_build_uint32( inMsg.cbuf, 4 );
    792          
    793              switch ( cmndId )
    794              {
    795                case CMD_INCR:
    796                  counter += 1;  /* 递增接收到的计数器 */
    797                                 /* 故意落入下一个case */
    798          
    799                case CMD_ECHO:
    800                {
    801                  userQueue_t outMsg;
    802          
    803                  outMsg.resp = RSP_CODE | cmndId;  /* 响应ID */
    804                  osal_buffer_uint32( outMsg.rbuf, counter );    /* 递增计数器 */
    805                  osal_queue_send( UserQueue1, &outMsg, 0 );  /* 发送回UserTask */
    806                  break;
    807                }
    808          
    809                default:
    810                  break;  /* 忽略未知命令 */
    811              }
    812            }
    813          }
    814          #endif
