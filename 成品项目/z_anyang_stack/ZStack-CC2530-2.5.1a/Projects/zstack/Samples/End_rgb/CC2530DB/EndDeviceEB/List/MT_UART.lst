    338          /***************************************************************************************************
    339           * @fn      MT_UartProcessZAppData
    340           *
    341           * @brief   | SOP | CMD  |   Data Length   | FSC  |
    342           *          |  1  |  2   |       1         |  1   |
    343           *
    344           *          Parses the data and determine either is SPI or just simply serial data
    345           *          then send the data to correct place (MT or APP)
    346           *
    347           * @param   port    - UART port
    348           *          event   - Event that causes the callback
    349           *
    350           *
    351           * @return  None
    352           ***************************************************************************************************/
    353          void MT_UartProcessZAppData ( uint8 port, uint8 event )
    354          {
    355          
    356            osal_event_hdr_t  *msg_ptr;
    357            uint16 length = 0;
    358            uint16 rxBufLen  = Hal_UART_RxBufLen(MT_UART_DEFAULT_PORT);
    359          
    360            /*
    361               If maxZAppBufferLength is 0 or larger than current length
    362               the entire length of the current buffer is returned.
    363            */
    364            if ((MT_UartMaxZAppBufLen != 0) && (MT_UartMaxZAppBufLen <= rxBufLen))
    365            {
    366              length = MT_UartMaxZAppBufLen;
    367            }
    368            else
    369            {
    370              length = rxBufLen;
    371            }
    372          
    373            /* Verify events */
    374            if (event == HAL_UART_TX_FULL)
    375            {
    376              // Do something when TX if full
    377              return;
    378            }
    379          
    380            if (event & ( HAL_UART_RX_FULL | HAL_UART_RX_ABOUT_FULL | HAL_UART_RX_TIMEOUT))
    381            {
    382              if ( App_TaskID )
    383              {
    384                /*
    385                   If Application is ready to receive and there is something
    386                   in the Rx buffer then send it up
    387                */
    388                if ((MT_UartZAppRxStatus == MT_UART_ZAPP_RX_READY ) && (length != 0))
    389                {
    390                  /* Disable App flow control until it processes the current data */
    391                   MT_UartAppFlowControl (MT_UART_ZAPP_RX_NOT_READY);
    392          
    393                  /* 2 more bytes are added, 1 for CMD type, other for length */
    394                  msg_ptr = (osal_event_hdr_t *)osal_msg_allocate( length + sizeof(osal_event_hdr_t) );
    395                  if ( msg_ptr )
    396                  {
    397                    msg_ptr->event = SPI_INCOMING_ZAPP_DATA;
    398                    msg_ptr->status = length;
    399          
    400                    /* Read the data of Rx buffer */
    401                    HalUARTRead( MT_UART_DEFAULT_PORT, (uint8 *)(msg_ptr + 1), length );
    402          
    403                    /* Send the raw data to application...or where ever */
    404                    osal_msg_send( App_TaskID, (uint8 *)msg_ptr );
    405                  }
    406                }
    407              }
    408            }
    409          }
    410          
    411          /***************************************************************************************************
    412           * @fn      SPIMgr_ZAppBufferLengthRegister
    413           *
    414           * @brief
    415           *
    416           * @param   maxLen - Max Length that the application wants at a time
    417           *
    418           * @return  None
    419           *
    420           ***************************************************************************************************/
    421          void MT_UartZAppBufferLengthRegister ( uint16 maxLen )
    422          {
    423            /* If the maxLen is larger than the RX buff, something is not right */
    424            if (maxLen <= MT_UART_DEFAULT_MAX_RX_BUFF)
    425              MT_UartMaxZAppBufLen = maxLen;
    426            else
    427              MT_UartMaxZAppBufLen = 1; /* default is 1 byte */
    428          }
    429          
    430          /***************************************************************************************************
    431           * @fn      SPIMgr_AppFlowControl
    432           *
    433           * @brief
    434           *
    435           * @param   status - ready to send or not
    436           *
    437           * @return  None
    438           *
    439           ***************************************************************************************************/
    440          void MT_UartAppFlowControl ( bool status )
    441          {
    442          
    443            /* Make sure only update if needed */
    444            if (status != MT_UartZAppRxStatus )
    445            {
    446              MT_UartZAppRxStatus = status;
    447            }
    448          
    449            /* App is ready to read again, ProcessZAppData have to be triggered too */
    450            if (status == MT_UART_ZAPP_RX_READY)
    451            {
    452              MT_UartProcessZAppData (MT_UART_DEFAULT_PORT, HAL_UART_RX_TIMEOUT );
    453            }
    454          
    455          }
    456          
    457          #endif //ZAPP
