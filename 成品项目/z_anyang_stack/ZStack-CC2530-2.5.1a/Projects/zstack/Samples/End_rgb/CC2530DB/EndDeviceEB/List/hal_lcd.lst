     53          /**************************************************************************************************
     54           *                                          CONSTANTS
     55           **************************************************************************************************/
     56          /*
     57            LCD pins
     58          
     59            //control
     60            P0.0 - LCD_BLK
     61            
     62            P1.2 - LCD_CS
     63          
     64            //spi
     65            P1.5 - CLK
     66            P1.6 - MOSI
     67            P1.7 - MISO  ->LCD_MODE
     68          */
     69          
     70          /* LCD Control lines */
     71          #define HAL_LCD_MODE_PORT 1
     72          #define HAL_LCD_MODE_PIN  7
     73          
     74          #define HAL_LCD_BLK_PORT 0
     75          #define HAL_LCD_BLK_PIN  0
     76          
     77          #define HAL_LCD_CS_PORT 1
     78          #define HAL_LCD_CS_PIN  2
     79          
     80          /* LCD SPI lines */
     81          #define HAL_LCD_CLK_PORT 1
     82          #define HAL_LCD_CLK_PIN  5
     83          
     84          #define HAL_LCD_MOSI_PORT 1
     85          #define HAL_LCD_MOSI_PIN  6
     86          
     87          #define HAL_LCD_MISO_PORT 1
     88          #define HAL_LCD_MISO_PIN  7
     89          
     90          /* SPI settings */
     91          #define HAL_SPI_CLOCK_POL_LO       0x00
     92          #define HAL_SPI_CLOCK_PHA_0        0x00
     93          #define HAL_SPI_TRANSFER_MSB_FIRST 0x20
     94          
     95          /* LCD lines */
     96          #define LCD_MAX_LINE_COUNT              8
     97          #define LCD_MAX_LINE_LENGTH             21
     98          #define LCD_MAX_BUF                     21
     99          
    100          /* Defines for HW LCD */
    101          
    102          /* Set power save mode */
    103          #define OSC_OFF                         0x00
    104          #define OSC_ON                          0x01
    105          #define POWER_SAVE_OFF                  0x00
    106          #define POWER_SAVE_ON                   0x02
    107          #define SET_POWER_SAVE_MODE(options)    HalLcd_HW_Control(0x0C | (options))
    108          
    109          /* Function Set */
    110          #define CGROM                           0x00
    111          #define CGRAM                           0x01
    112          #define COM_FORWARD                     0x00
    113          #define COM_BACKWARD                    0x02
    114          #define TWO_LINE                        0x00
    115          #define THREE_LINE                      0x04
    116          #define FUNCTION_SET(options)           HalLcd_HW_Control(0x10 | (options))
    117          
    118          /* Set Display Start Line */
    119          #define LINE1                           0x00
    120          #define LINE2                           0x01
    121          #define LINE3                           0x02
    122          #define LINE4                           0x03
    123          //以下是自已添加的，因为LCD只能支持5x7的ASCII码，所以可以有0-7行
    124          #define LINE5                           0x04
    125          #define LINE6                           0x05
    126          #define LINE7                           0x06
    127          #define LINE8                           0x07
    128          
    129          #define SET_DISPLAY_START_LINE(line)    HalLcd_HW_Control(0xB0 | (line))
    130          
    131          /* Bias control */
    132          #define BIAS_1_9                        0xA2
    133          #define BIAS_1_7                        0xA3
    134          #define SET_BIAS_CTRL(bias)             HalLcd_HW_Control(bias)
    135          
    136          /* Power control */
    137          #define VOLTAGE_DIVIDER_OFF             0x00
    138          #define VOLTAGE_DIVIDER_ON              0x01
    139          #define CONVERTER_AND_REG_OFF           0x00
    140          #define CONVERTER_AND_REG_ON            0x04
    141          #define SET_POWER_CTRL(options)         HalLcd_HW_Control(0x20 | (options))
    142          
    143          // Set display control
    144          #define DISPLAY_CTRL_ON                 0x01
    145          #define DISPLAY_CTRL_OFF                0x00
    146          #define DISPLAY_CTRL_BLINK_ON           0x02
    147          #define DISPLAY_CTRL_BLINK_OFF          0x00
    148          #define DISPLAY_CTRL_CURSOR_ON          0x04
    149          #define DISPLAY_CTRL_CURSOR_OFF         0x00
    150          #define SET_DISPLAY_CTRL(options)       HalLcd_HW_Control(0x28 | (options))
    151          
    152          /* Set DD/ CGRAM address */
    153          #define SET_DDRAM_ADDR(page,charIndex)  HalLcd_HW_Control(0xB0 | (page)); \
    154                                                  HalLcd_HW_Control(((charIndex >>4) & 0x0f) + 0x10);\
    155                                                  HalLcd_HW_Control(charIndex & 0x0f)
    156          
    157          #define SET_GCRAM_CHAR(specIndex)       HalLcd_HW_Control(0xC0 | (specIndex))
    158          
    159          /* Set ICONRAM address */
    160          #define CONTRAST_CTRL_REGISTER          0x10
    161          #define SET_ICONRAM_ADDR(addr)          HalLcd_HW_Control(0x40 | (addr))
    162          
    163          /* Set double height */
    164          #define LINE_1_AND_2                    0x01
    165          #define LINE_2_AND_3                    0x02
    166          #define NORMAL_DISPLAY                  0x00
    167          #define SET_DOUBLE_HEIGHT(options)      HalLcd_HW_Control(0x08 | (options))
    168          
    169          //所有ASCII码字库，此LCD不带字库5X7:X =5 Y = 7

