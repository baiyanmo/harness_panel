    692          /**************************************************************************************************
    693           * @fn      halLcd_ConfigSPI
    694           *
    695           * @brief   Configure SPI lines needed for talking to LCD.
    696           *
    697           * @param   None
    698           *
    699           * @return  None
    700           **************************************************************************************************/
    701          static void halLcd_ConfigSPI(void)
    702          {
    703            /* UART/SPI Peripheral configuration */
    704          
    705             uint8 baud_exponent;
    706             uint8 baud_mantissa;
    707          
    708            /* Set SPI on UART 1 alternative 2 */
    709            PERCFG |= 0x02;
    710          
    711            /* Configure clk, master out and master in lines */
    712            HAL_CONFIG_IO_PERIPHERAL(HAL_LCD_CLK_PORT,  HAL_LCD_CLK_PIN);
    713            HAL_CONFIG_IO_PERIPHERAL(HAL_LCD_MOSI_PORT, HAL_LCD_MOSI_PIN);
    714          // HAL_CONFIG_IO_PERIPHERAL(HAL_LCD_MISO_PORT, HAL_LCD_MISO_PIN);
    715          
    716          
    717            /* Set SPI speed to 1 MHz (the values assume system clk of 32MHz)
    718             * Confirm on board that this results in 1MHz spi clk.
    719             */
    720            baud_exponent = 15;
    721            baud_mantissa =  0;
    722          
    723            /* Configure SPI */
    724            U1UCR  = 0x80;      /* Flush and goto IDLE state. 8-N-1. */
    725            U1CSR  = 0x00;      /* SPI mode, master. */
    726            U1GCR  = HAL_SPI_TRANSFER_MSB_FIRST | HAL_SPI_CLOCK_PHA_0 | HAL_SPI_CLOCK_POL_LO | baud_exponent;
    727            U1BAUD = baud_mantissa;
    728          }
