    269          /**************************************************************************************************
    270           *                                           MACROS
    271           **************************************************************************************************/
    272          
    273          #define HAL_IO_SET(port, pin, val)        HAL_IO_SET_PREP(port, pin, val)
    274          #define HAL_IO_SET_PREP(port, pin, val)   st( P##port##_##pin## = val; )
    275          
    276          #define HAL_CONFIG_IO_OUTPUT(port, pin, val)      HAL_CONFIG_IO_OUTPUT_PREP(port, pin, val)
    277          #define HAL_CONFIG_IO_OUTPUT_PREP(port, pin, val) st( P##port##SEL &= ~BV(pin); \
    278                                                                P##port##_##pin## = val; \
    279                                                                P##port##DIR |= BV(pin); )
    280          
    281          #define HAL_CONFIG_IO_PERIPHERAL(port, pin)      HAL_CONFIG_IO_PERIPHERAL_PREP(port, pin)
    282          #define HAL_CONFIG_IO_PERIPHERAL_PREP(port, pin) st( P##port##SEL |= BV(pin); )
    283          
    284          
    285          
    286          /* SPI interface control */
    287          #define LCD_SPI_BEGIN()     HAL_IO_SET(HAL_LCD_CS_PORT,  HAL_LCD_CS_PIN,  0); /* chip select */
    288          #define LCD_SPI_END()                                                         \
    289          {                                                                             \
    290            asm("NOP");                                                                 \
    291            asm("NOP");                                                                 \
    292            asm("NOP");                                                                 \
    293            asm("NOP");                                                                 \
    294            HAL_IO_SET(HAL_LCD_CS_PORT,  HAL_LCD_CS_PIN,  1); /* chip select */         \
    295          }
    296          /* clear the received and transmit byte status, write tx data to buffer, wait till transmit done */
    297          #define LCD_SPI_TX(x)                   { U1CSR &= ~(BV(2) | BV(1)); U1DBUF = x; while( !(U1CSR & BV(1)) ); }
    298          #define LCD_SPI_WAIT_RXRDY()            { while(!(U1CSR & BV(1))); }
    299          
    300          
    301          /* Control macros */
    302          #define LCD_DO_WRITE()        HAL_IO_SET(HAL_LCD_MODE_PORT,  HAL_LCD_MODE_PIN,  1);
    303          #define LCD_DO_CONTROL()      HAL_IO_SET(HAL_LCD_MODE_PORT,  HAL_LCD_MODE_PIN,  0);
    304          
    305          //#define LCD_ACTIVATE_RESET()  HAL_IO_SET(HAL_LCD_RESET_PORT, HAL_LCD_RESET_PIN, 0);
    306          #define  LCD_ACTIVATE_RESET()   HalLcd_HW_Control(0xE2)
    307          //#define LCD_RELEASE_RESET()   HAL_IO_SET(HAL_LCD_RESET_PORT, HAL_LCD_RESET_PIN, 1);
    308          #define LCD_RELEASE_RESET()     asm("NOP")
    309          #if (HAL_LCD == TRUE)
    310          /**************************************************************************************************
    311           *                                       LOCAL VARIABLES
    312           **************************************************************************************************/
    313          typedef const char *LcdScreen;
    314          typedef struct
    315          {
    316            LcdScreen  Lcd[6];
    317            signed char header;
    318            signed char tail;
    319            uint8 lcdbuf[LCD_MAX_BUF];  //变量显示缓存
    320          }LcdCache;

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    321          LcdCache LcdBuffer;
   \                     LcdBuffer:
   \   000000                DS 35
   \   000023                REQUIRE __INIT_XDATA_Z
    322          
    323          //static uint8 *Lcd_Line1;
    324          
    325          /**************************************************************************************************
    326           *                                       FUNCTIONS - API
    327           **************************************************************************************************/
    328          
    329          void HalLcd_HW_Init(void);
    330          void HalLcd_HW_WaitUs(uint16 i);
    331          void HalLcd_HW_Clear(void);
    332          void HalLcd_HW_ClearAllSpecChars(void);
    333          void HalLcd_HW_Control(uint8 cmd);
    334          void HalLcd_HW_Write(uint8 data);
    335          //void HalLcd_HW_SetContrast(uint8 value);
    336          void HalLcd_HW_WriteChar(uint8 line, uint8 col, char text);
    337          void HalLcd_HW_WriteLine(uint8 line, const char *pText);
    338          void HalLcdBufferInit(void);
    339          void set_ddram_line_col(uint8 line,uint8 col);
    340          /*
    341          作用    设置LCD 文本显示的其实行和列
    342          参数1   line,范围:0~7,即能够显示的行为1~8行，也就是lcd手册里提到的page
    343          参数2   col,范围:0~127,即lcd的总列数，显示的起始位置可以设置到每一列
    344          */

   \                                 In  segment BANKED_CODE, align 1, keep-with-next
    345          void set_ddram_line_col(uint8 line,uint8 col)
   \                     set_ddram_line_col:
    346          {
   \   000000   74F7         MOV       A,#-0x9
   \   000002   12....       LCALL     ?BANKED_ENTER_XDATA
