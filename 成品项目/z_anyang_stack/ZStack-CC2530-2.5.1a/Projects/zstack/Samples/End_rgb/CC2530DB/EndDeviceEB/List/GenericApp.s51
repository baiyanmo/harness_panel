//  560  * @fn      GenericApp_HandleKeys
//  561  *
//  562  * @brief   处理本设备的所有按键事件
//  563  *
//  564  * @param   shift - 是否按下Shift/Alt键（双功能键）。
//  565  * @param   keys  - 按键事件位域。有效值：
//  566  *                  HAL_KEY_SW_4
//  567  *                  HAL_KEY_SW_3
//  568  *                  HAL_KEY_SW_2
//  569  *                  HAL_KEY_SW_1
//  570  *
//  571  * @return  无
//  572  */
//  573 static void GenericApp_HandleKeys( uint8 shift, uint8 keys )
//  574 {
//  575   zAddrType_t dstAddr;
//  576 
//  577   // Shift用于实现每个按键的双功能
//  578   if ( shift )
//  579   {
//  580     if ( keys & HAL_KEY_SW_1 )
//  581     {
//  582     }
//  583     if ( keys & HAL_KEY_SW_2 )
//  584     {
//  585     }
//  586     if ( keys & HAL_KEY_SW_3 )
//  587     {
//  588     }
//  589     if ( keys & HAL_KEY_SW_4 )
//  590     {
//  591     }
//  592   }
//  593   else
//  594   {
//  595     if ( keys & HAL_KEY_SW_1 )
//  596     {
//  597       // SW1在本应用中未用于其他功能
//  598 #if defined( SWITCH1_BIND )
//  599       // 可以用SW1模拟SW2的功能（用于只有一个按键的设备）
//  600       keys |= HAL_KEY_SW_2;
//  601 #elif defined( SWITCH1_MATCH )
//  602       // 或者用SW1模拟SW4的功能（用于只有一个按键的设备）
//  603       keys |= HAL_KEY_SW_4;
//  604 #endif
//  605     }
//  606 
//  607     if ( keys & HAL_KEY_SW_2 )
//  608     {
//  609       HalLedSet ( HAL_LED_4, HAL_LED_MODE_OFF );
//  610 
//  611       // 向协调器发起终端设备绑定请求
//  612       dstAddr.addrMode = Addr16Bit;
//  613       dstAddr.addr.shortAddr = 0x0000; // 协调器地址
//  614       ZDP_EndDeviceBindReq( &dstAddr, NLME_GetShortAddr(),
