        ARGFRAME XSTACK, 9, STACK
        ARGFRAME IOVERLAY, 0, STATIC
        ARGFRAME DOVERLAY, 0, STATIC
        FUNCALL GenericApp_Init, ZDO_RegisterForZDOMsg
        LOCFRAME ISTACK, 0, STACK
        LOCFRAME PSTACK, 0, STACK
        LOCFRAME XSTACK, 9, STACK
        LOCFRAME IOVERLAY, 0, STATIC
        LOCFRAME DOVERLAY, 0, STATIC
        ARGFRAME ISTACK, 0, STACK
        ARGFRAME PSTACK, 0, STACK
        ARGFRAME XSTACK, 9, STACK
        ARGFRAME IOVERLAY, 0, STATIC
        ARGFRAME DOVERLAY, 0, STATIC
        FUNCALL GenericApp_Init, osal_start_timerEx
        LOCFRAME ISTACK, 0, STACK
        LOCFRAME PSTACK, 0, STACK
        LOCFRAME XSTACK, 9, STACK
        LOCFRAME IOVERLAY, 0, STATIC
        LOCFRAME DOVERLAY, 0, STATIC
        ARGFRAME ISTACK, 0, STACK
        ARGFRAME PSTACK, 0, STACK
        ARGFRAME XSTACK, 9, STACK
        ARGFRAME IOVERLAY, 0, STATIC
        ARGFRAME DOVERLAY, 0, STATIC
        MOV       A,#-0x9
        LCALL     ?BANKED_ENTER_XDATA
          CFI DPH0 load(1, XDATA, add(CFA_XSP16, literal(-1)))
          CFI DPL0 load(1, XDATA, add(CFA_XSP16, literal(-2)))
          CFI ?BRET_EXT load(1, XDATA, add(CFA_XSP16, literal(-3)))
          CFI ?RET_HIGH load(1, XDATA, add(CFA_XSP16, literal(-4)))
          CFI ?RET_LOW load(1, XDATA, add(CFA_XSP16, literal(-5)))
          CFI R7 load(1, XDATA, add(CFA_XSP16, literal(-6)))
          CFI V0 load(1, XDATA, add(CFA_XSP16, literal(-7)))
          CFI VB load(1, XDATA, add(CFA_XSP16, literal(-8)))
          CFI R6 load(1, XDATA, add(CFA_XSP16, literal(-9)))
          CFI CFA_SP SP+0
          CFI CFA_XSP16 add(XSP16, 9)
        ; Saved register size: 9
        ; Auto size: 0
        MOV       A,R1
//  208   GenericApp_TaskID = task_id;
        MOV       DPTR,#GenericApp_TaskID
        MOVX      @DPTR,A
//  209   GenericApp_NwkState = DEV_INIT;
        MOV       DPTR,#GenericApp_NwkState
        MOV       A,#0x1
        MOVX      @DPTR,A
//  210   GenericApp_TransID = 0;
        MOV       DPTR,#GenericApp_TransID
        CLR       A
        MOVX      @DPTR,A
//  211 
//  212   // 设备硬件初始化可以在这里或在 main() (Zmain.c) 中添加
//  213   // 如果硬件与应用相关，在这里添加
//  214   // 如果是设备的其他部分，在 main() 中添加
//  215 
//  216   MT_UartInit();//串口初始化
        ; Setup parameters for call to function MT_UartInit
        LCALL     `??MT_UartInit::?relay`; Banked call to: MT_UartInit
//  217   HalUARTWrite(0,"jfjidij\n\r",sizeof("jfjidij"));//串口测试
        ; Setup parameters for call to function HalUARTWrite
        MOV       R4,#0x8
        MOV       R5,#0x0
        MOV       R2,#`?<Constant "jfjidij\\n\\r">` & 0xff
        MOV       R3,#(`?<Constant "jfjidij\\n\\r">` >> 8) & 0xff
        MOV       R1,#0x0
        LCALL     `??HalUARTWrite::?relay`; Banked call to: HalUARTWrite
//  218 
//  219   RGB_Config();//RGB灯初始化
        ; Setup parameters for call to function RGB_Config
        LCALL     `??RGB_Config::?relay`; Banked call to: RGB_Config
//  220   Su03t_Config();//su-03t语音模块初始化
        ; Setup parameters for call to function Su03t_Config
        LCALL     `??Su03t_Config::?relay`; Banked call to: Su03t_Config
//  221 
//  222 //  GenericApp_DstAddr.addrMode = (afAddrMode_t)AddrNotPresent;
//  223 //  GenericApp_DstAddr.endPoint = 0;
//  224 //  GenericApp_DstAddr.addr.shortAddr = 0;
//  225   GenericApp_DstAddr.addrMode = (afAddrMode_t)Addr16Bit;
        MOV       DPTR,#GenericApp_DstAddr + 8
        MOV       A,#0x2
        MOVX      @DPTR,A
//  226   GenericApp_DstAddr.endPoint = GENERICAPP_ENDPOINT;
        INC       DPTR
        MOV       A,#0xa
        MOVX      @DPTR,A
//  227   GenericApp_DstAddr.addr.shortAddr = 0;
        MOV       DPTR,#GenericApp_DstAddr
        CLR       A
        MOVX      @DPTR,A
        INC       DPTR
        MOVX      @DPTR,A
//  228 
//  229   // 填充端点描述符
//  230   GenericApp_epDesc.endPoint = GENERICAPP_ENDPOINT;
        MOV       DPTR,#GenericApp_epDesc
        MOV       A,#0xa
        MOVX      @DPTR,A
//  231   GenericApp_epDesc.task_id = &GenericApp_TaskID;
        INC       DPTR
        MOV       A,#GenericApp_TaskID & 0xff
        MOVX      @DPTR,A
        INC       DPTR
        MOV       A,#(GenericApp_TaskID >> 8) & 0xff
        MOVX      @DPTR,A
//  232   GenericApp_epDesc.simpleDesc
//  233             = (SimpleDescriptionFormat_t *)&GenericApp_SimpleDesc;
        INC       DPTR
        MOV       A,#GenericApp_SimpleDesc & 0xff
        MOVX      @DPTR,A
        INC       DPTR
        MOV       A,#(GenericApp_SimpleDesc >> 8) & 0xff
        MOVX      @DPTR,A
//  234   GenericApp_epDesc.latencyReq = noLatencyReqs;
