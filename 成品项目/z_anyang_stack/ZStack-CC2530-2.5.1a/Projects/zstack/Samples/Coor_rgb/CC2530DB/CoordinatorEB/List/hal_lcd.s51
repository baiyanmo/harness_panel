//  675 /**************************************************************************************************
//  676  * @fn      halLcd_ConfigIO
//  677  *
//  678  * @brief   Configure IO lines needed for LCD control.
//  679  *
//  680  * @param   None
//  681  *
//  682  * @return  None
//  683  **************************************************************************************************/
//  684 static void halLcd_ConfigIO(void)
//  685 {
//  686   /* GPIO configuration */
//  687   HAL_CONFIG_IO_OUTPUT(HAL_LCD_MODE_PORT,  HAL_LCD_MODE_PIN,  1);
//  688   HAL_CONFIG_IO_OUTPUT(HAL_LCD_BLK_PORT, HAL_LCD_BLK_PIN, 1);
