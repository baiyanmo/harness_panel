//   72  * CONSTANTS
//   73  */
//   74 
//   75 // UxCSR - USART Control and Status Register.
//   76 #define CSR_MODE                   0x80
//   77 #define CSR_RE                     0x40
//   78 #define CSR_SLAVE                  0x20
//   79 #define CSR_FE                     0x10
//   80 #define CSR_ERR                    0x08
//   81 #define CSR_RX_BYTE                0x04
//   82 #define CSR_TX_BYTE                0x02
//   83 #define CSR_ACTIVE                 0x01
//   84 
//   85 // UxUCR - USART UART Control Register.
//   86 #define UCR_FLUSH                  0x80
//   87 #define UCR_FLOW                   0x40
//   88 #define UCR_D9                     0x20
//   89 #define UCR_BIT9                   0x10
//   90 #define UCR_PARITY                 0x08
//   91 #define UCR_SPB                    0x04
//   92 #define UCR_STOP                   0x02
//   93 #define UCR_START                  0x01
//   94 
//   95 #define UTX0IE                     0x04
//   96 #define UTX1IE                     0x08
//   97 
//   98 #define P2DIR_PRIPO                0xC0
//   99 
//  100 // Incompatible redefinitions result with more than one UART driver sub-module.
//  101 #undef PxOUT
//  102 #undef PxDIR
//  103 #undef PxSEL
//  104 #undef UxCSR
//  105 #undef UxUCR
//  106 #undef UxDBUF
//  107 #undef UxBAUD
//  108 #undef UxGCR
//  109 #undef URXxIE
//  110 #undef URXxIF
//  111 #undef UTXxIE
//  112 #undef UTXxIF
//  113 #undef HAL_UART_PERCFG_BIT
//  114 #undef HAL_UART_Px_RTS
//  115 #undef HAL_UART_Px_CTS
//  116 #undef HAL_UART_Px_RX_TX
//  117 #if (HAL_UART_ISR == 1)
//  118 #define PxOUT                      P0
//  119 #define PxDIR                      P0DIR
//  120 #define PxSEL                      P0SEL
//  121 #define UxCSR                      U0CSR
//  122 #define UxUCR                      U0UCR
//  123 #define UxDBUF                     U0DBUF
//  124 #define UxBAUD                     U0BAUD
//  125 #define UxGCR                      U0GCR
//  126 #define URXxIE                     URX0IE
//  127 #define URXxIF                     URX0IF
//  128 #define UTXxIE                     UTX0IE
//  129 #define UTXxIF                     UTX0IF
//  130 #else
//  131 #define PxOUT                      P1
//  132 #define PxDIR                      P1DIR
//  133 #define PxSEL                      P1SEL
//  134 #define UxCSR                      U1CSR
//  135 #define UxUCR                      U1UCR
//  136 #define UxDBUF                     U1DBUF
//  137 #define UxBAUD                     U1BAUD
//  138 #define UxGCR                      U1GCR
//  139 #define URXxIE                     URX1IE
//  140 #define URXxIF                     URX1IF
//  141 #define UTXxIE                     UTX1IE
//  142 #define UTXxIF                     UTX1IF
//  143 #endif
//  144 
//  145 #if (HAL_UART_ISR == 1)
//  146 #define HAL_UART_PERCFG_BIT        0x01         // USART0 on P0, Alt-1; so clear this bit.
//  147 #define HAL_UART_Px_RX_TX          0x0C         // Peripheral I/O Select for Rx/Tx.
//  148 #define HAL_UART_Px_RTS            0x20         // Peripheral I/O Select for RTS.
//  149 #define HAL_UART_Px_CTS            0x10         // Peripheral I/O Select for CTS.
//  150 #else
//  151 #define HAL_UART_PERCFG_BIT        0x02         // USART1 on P1, Alt-2; so set this bit.
//  152 #define HAL_UART_Px_RTS            0x20         // Peripheral I/O Select for RTS.
//  153 #define HAL_UART_Px_CTS            0x10         // Peripheral I/O Select for CTS.
//  154 #define HAL_UART_Px_RX_TX          0xC0         // Peripheral I/O Select for Rx/Tx.
//  155 #endif
//  156 
//  157 // The timeout tick is at 32-kHz, so multiply msecs by 33.
//  158 #define HAL_UART_MSECS_TO_TICKS    33
//  159 
//  160 #if defined MT_TASK
//  161 #define HAL_UART_ISR_TX_MAX        MT_UART_DEFAULT_MAX_TX_BUFF
//  162 #define HAL_UART_ISR_RX_MAX        MT_UART_DEFAULT_MAX_RX_BUFF
//  163 #define HAL_UART_ISR_HIGH          MT_UART_DEFAULT_THRESHOLD
//  164 #define HAL_UART_ISR_IDLE         (MT_UART_DEFAULT_IDLE_TIMEOUT * HAL_UART_MSECS_TO_TICKS)
//  165 #else
//  166 #if !defined HAL_UART_ISR_RX_MAX
//  167 #define HAL_UART_ISR_RX_MAX        128
//  168 #endif
//  169 #if !defined HAL_UART_ISR_TX_MAX
//  170 #define HAL_UART_ISR_TX_MAX        HAL_UART_ISR_RX_MAX
//  171 #endif
//  172 #if !defined HAL_UART_ISR_HIGH
//  173 #define HAL_UART_ISR_HIGH         (HAL_UART_ISR_RX_MAX / 2 - 16)
//  174 #endif
//  175 #if !defined HAL_UART_ISR_IDLE
//  176 #define HAL_UART_ISR_IDLE         (6 * HAL_UART_MSECS_TO_TICKS)
//  177 #endif
//  178 #endif
