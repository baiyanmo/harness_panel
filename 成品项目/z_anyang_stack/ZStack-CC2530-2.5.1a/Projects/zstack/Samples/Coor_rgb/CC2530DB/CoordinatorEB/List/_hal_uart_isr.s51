        MOV       R1,#0x0
        SJMP      ??HalUARTReadISR_0
//  356 
//  357   while ((isrCfg.rxHead != isrCfg.rxTail) && (cnt < len))
//  358   {
//  359     *buf++ = isrCfg.rxBuf[isrCfg.rxHead++];
??HalUARTReadISR_1:
        MOV       A,#isrCfg & 0xff
        ADD       A,R6
        MOV       DPL,A
        CLR       A
        ADDC      A,#(isrCfg >> 8) & 0xff
        MOV       DPH,A
