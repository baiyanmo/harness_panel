//  281 /******************************************************************************
//  282  * @fn      HalUARTOpenISR
//  283  *
//  284  * @brief   Open a port according tp the configuration specified by parameter.
//  285  *
//  286  * @param   config - contains configuration information
//  287  *
//  288  * @return  none
//  289  *****************************************************************************/
//  290 static void HalUARTOpenISR(halUARTCfg_t *config)
//  291 {
//  292   isrCfg.uartCB = config->callBackFunc;
//  293   // Only supporting subset of baudrate for code size - other is possible.
//  294   HAL_UART_ASSERT((config->baudRate == HAL_UART_BR_9600) ||
//  295                   (config->baudRate == HAL_UART_BR_19200) ||
//  296                   (config->baudRate == HAL_UART_BR_38400) ||
//  297                   (config->baudRate == HAL_UART_BR_57600) ||
//  298                   (config->baudRate == HAL_UART_BR_115200));
//  299   
//  300   if (config->baudRate == HAL_UART_BR_57600 ||
//  301       config->baudRate == HAL_UART_BR_115200)
//  302   {
//  303     UxBAUD = 216;
//  304   }
//  305   else
//  306   {
//  307     UxBAUD = 59;
//  308   }
//  309   
//  310   switch (config->baudRate)
//  311   {
//  312     case HAL_UART_BR_9600:
//  313       UxGCR = 8;
//  314       break;
//  315     case HAL_UART_BR_19200:
//  316       UxGCR = 9;
//  317       break;
//  318     case HAL_UART_BR_38400:
//  319     case HAL_UART_BR_57600:
//  320       UxGCR = 10;
//  321       break;
//  322     default:
//  323       UxGCR = 11;
//  324       break;
//  325   }
//  326 
//  327   // 8 bits/char; no parity; 1 stop bit; stop bit hi.
//  328   if (config->flowControl)
//  329   {
//  330     UxUCR = UCR_FLOW | UCR_STOP;
//  331     PxSEL |= HAL_UART_Px_RTS | HAL_UART_Px_CTS;
//  332   }
//  333   else
//  334   {
//  335     UxUCR = UCR_STOP;
//  336   }
//  337 
//  338   UxCSR |= CSR_RE;
//  339   URXxIE = 1;
//  340   UTXxIF = 1;  // Prime the ISR pump.
//  341 }
