//   59 #define HAL_UART_ASSERT(expr)
//   60 
//   61 #define HAL_UART_ISR_RX_AVAIL() \ 
//   62   (isrCfg.rxTail >= isrCfg.rxHead) ? \ 
//   63   (isrCfg.rxTail - isrCfg.rxHead) : \ 
//   64   (HAL_UART_ISR_RX_MAX - isrCfg.rxHead + isrCfg.rxTail)
//   65 
//   66 #define HAL_UART_ISR_TX_AVAIL() \ 
//   67   (isrCfg.txHead > isrCfg.txTail) ? \ 
//   68   (isrCfg.txHead - isrCfg.txTail - 1) : \ 
//   69   (HAL_UART_ISR_TX_MAX - isrCfg.txTail + isrCfg.txHead - 1)
