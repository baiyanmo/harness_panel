//  361     {
//  362       isrCfg.rxHead = 0;
        MOV       DPTR,#isrCfg + 128
        CLR       A
        MOVX      @DPTR,A
//  363     }
//  364     cnt++;
??HalUARTReadISR_2:
        INC       R0
        MOV       A,R0
