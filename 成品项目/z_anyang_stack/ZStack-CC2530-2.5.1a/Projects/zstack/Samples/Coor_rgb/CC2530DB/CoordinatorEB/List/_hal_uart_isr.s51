//  188   uint8 rxHead;
//  189   volatile uint8 rxTail;
//  190 #else
//  191   uint16 rxHead;
//  192   volatile uint16 rxTail;
//  193 #endif
//  194   uint8 rxTick;
//  195   uint8 rxShdw;
//  196 
//  197   uint8 txBuf[HAL_UART_ISR_TX_MAX];
//  198 #if HAL_UART_ISR_TX_MAX < 256
//  199   volatile uint8 txHead;
//  200   uint8 txTail;
//  201 #else
//  202   volatile uint16 txHead;
//  203   uint16 txTail;
//  204 #endif
//  205   uint8 txMT;
//  206 
