    517          
    518          /*********************************************************************
    519           * @fn      GenericApp_ProcessZDOMsgs()
    520           *
    521           * @brief   处理ZDO响应消息
    522           *
    523           * @param   none
    524           *
    525           * @return  none
    526           */
    527          static void GenericApp_ProcessZDOMsgs( zdoIncomingMsg_t *inMsg )
    528          {
    529            switch ( inMsg->clusterID )
    530            {
    531              case End_Device_Bind_rsp:
    532                if ( ZDO_ParseBindRsp( inMsg ) == ZSuccess )
    533                {
    534                  // 点亮LED
    535                  HalLedSet( HAL_LED_4, HAL_LED_MODE_ON );
    536                }
    537          #if defined( BLINK_LEDS )
    538                else
    539                {
    540                  // LED闪烁表示绑定失败
    541                  HalLedSet ( HAL_LED_4, HAL_LED_MODE_FLASH );
    542                }
    543          #endif
    544                break;
    545          
    546              case Match_Desc_rsp:
    547                {
    548                  ZDO_ActiveEndpointRsp_t *pRsp = ZDO_ParseEPListRsp( inMsg );
    549                  if ( pRsp )
    550                  {
    551                    if ( pRsp->status == ZSuccess && pRsp->cnt )
    552                    {
    553                      GenericApp_DstAddr.addrMode = (afAddrMode_t)Addr16Bit;
    554                      GenericApp_DstAddr.addr.shortAddr = pRsp->nwkAddr;
    555                      // 取第一个端点，可修改为遍历所有端点
    556                      GenericApp_DstAddr.endPoint = pRsp->epList[0];
    557          
    558                      // 点亮LED
    559                      HalLedSet( HAL_LED_4, HAL_LED_MODE_ON );
    560                    }
    561                    osal_mem_free( pRsp );
    562                  }
    563                }
    564                break;
    565            }
    566          }
    567          
    568          /*********************************************************************
    569           * @fn      GenericApp_HandleKeys
    570           *
    571           * @brief   处理本设备的所有按键事件
    572           *
    573           * @param   shift - 是否按下Shift/Alt键
    574           * @param   keys  - 按键事件位域，有效值：
    575           *                  HAL_KEY_SW_4, HAL_KEY_SW_3,
    576           *                  HAL_KEY_SW_2, HAL_KEY_SW_1
    577           *
    578           * @return  none
    579           */
    580          static void GenericApp_HandleKeys( uint8 shift, uint8 keys )
    581          {
    582            zAddrType_t dstAddr;
    583          
    584            // Shift键用于切换按键的第二功能
    585            if ( shift )
    586            {
    587              if ( keys & HAL_KEY_SW_1 )
    588              {
    589              }
    590              if ( keys & HAL_KEY_SW_2 )
    591              {
    592              }
    593              if ( keys & HAL_KEY_SW_3 )
    594              {
    595              }
    596              if ( keys & HAL_KEY_SW_4 )
    597              {
    598              }
    599            }
    600            else
    601            {
    602              if ( keys & HAL_KEY_SW_1 )
    603              {
    604                // SW1未被其他功能占用时...
    605          #if defined( SWITCH1_BIND )
    606                // 用SW1模拟SW2（仅有一个按键的设备）
    607                keys |= HAL_KEY_SW_2;
    608          #elif defined( SWITCH1_MATCH )
    609                // 或用SW1模拟SW4（仅有一个按键的设备）
    610                keys |= HAL_KEY_SW_4;
    611          #endif
    612              }
    613          
    614              if ( keys & HAL_KEY_SW_2 )
    615              {
    616                HalLedSet ( HAL_LED_4, HAL_LED_MODE_OFF );
    617          
    618                // 对必选端点发起终端设备绑定请求
    619                dstAddr.addrMode = Addr16Bit;
    620                dstAddr.addr.shortAddr = 0x0000; // 协调器地址
    621                ZDP_EndDeviceBindReq( &dstAddr, NLME_GetShortAddr(),
    622                                      GenericApp_epDesc.endPoint,
    623                                      GENERICAPP_PROFID,
    624                                      GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    625                                      GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    626                                      FALSE );
    627              }
    628          
    629              if ( keys & HAL_KEY_SW_3 )
    630              {
    631              }
    632          
    633              if ( keys & HAL_KEY_SW_4 )
    634              {
    635                HalLedSet ( HAL_LED_4, HAL_LED_MODE_OFF );
    636                // 发起匹配描述符请求（服务发现）
    637                dstAddr.addrMode = AddrBroadcast;
    638                dstAddr.addr.shortAddr = NWK_BROADCAST_SHORTADDR;
    639                ZDP_MatchDescReq( &dstAddr, NWK_BROADCAST_SHORTADDR,
    640                                  GENERICAPP_PROFID,
    641                                  GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    642                                  GENERICAPP_MAX_CLUSTERS, (cId_t *)GenericApp_ClusterList,
    643                                  FALSE );
    644              }
    645            }
    646          }
