    693          
    694          /*********************************************************************
    695           * @fn      GenericApp_SendTheMessage
    696           *
    697           * @brief   发送消息函数
    698           *
    699           * @param   none
    700           *
    701           * @return  none
    702           */
    703          static void GenericApp_SendTheMessage( void )
    704          {
    705            char theMessageData[] = "Hello World";
    706          
    707            if ( AF_DataRequest( &GenericApp_DstAddr, &GenericApp_epDesc,
    708                                 GENERICAPP_CLUSTERID,
    709                                 (byte)osal_strlen( theMessageData ) + 1,
    710                                 (byte *)&theMessageData,
    711                                 &GenericApp_TransID,
    712                                 AF_DISCV_ROUTE, AF_DEFAULT_RADIUS ) == afStatus_SUCCESS )
    713            {
    714              // 消息发送请求成功
    715            }
    716            else
    717            {
    718              // 消息发送请求失败
    719            }
    720          }
    721          
    722          #if defined( IAR_ARMCM3_LM )
    723          /*********************************************************************
    724           * @fn      GenericApp_ProcessRtosMessage
    725           *
    726           * @brief   从RTOS队列接收消息并发送响应
    727           *
    728           * @param   none
    729           *
    730           * @return  none
    731           */
    732          static void GenericApp_ProcessRtosMessage( void )
    733          {
    734            osalQueue_t inMsg;
    735          
    736            if ( osal_queue_receive( OsalQueue, &inMsg, 0 ) == pdPASS )
    737            {
    738              uint8 cmndId = inMsg.cmnd;
    739              uint32 counter = osal_build_uint32( inMsg.cbuf, 4 );
    740          
    741              switch ( cmndId )
    742              {
    743                case CMD_INCR:
    744                  counter += 1;  /* 递增接收到的计数器 */
    745                                 /* 落入下一个case */
    746          
    747                case CMD_ECHO:
    748                {
    749                  userQueue_t outMsg;
    750          
    751                  outMsg.resp = RSP_CODE | cmndId;  /* 响应ID */
    752                  osal_buffer_uint32( outMsg.rbuf, counter );    /* 递增计数器 */
    753                  osal_queue_send( UserQueue1, &outMsg, 0 );  /* 发送回UserTask */
    754                  break;
    755                }
    756                
    757                default:
    758                  break;  /* 忽略未知命令 */    
    759              }
    760            }
    761          }
    762          #endif
    763          
    764          /*********************************************************************
    765           */

